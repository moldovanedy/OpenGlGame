<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <PublishTrimmed>true</PublishTrimmed>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="OpenTK" Version="4.9.4" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\OpenGlGame.Rendering\OpenGlGame.Rendering.csproj" />
        <ProjectReference Include="..\OpenGlGame.SceneSystem\OpenGlGame.SceneSystem.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="assets\**" Exclude="assets\**\*.blend*">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <TrimmerRootAssembly Include="OpenTK.Graphics" />
        <TrimmerRootAssembly Include="OpenTK.Windowing.Desktop" />
    </ItemGroup>
</Project>
